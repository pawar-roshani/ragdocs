# --- Application ---
APP_NAME=RAGDocs API
ENVIRONMENT=development
API_KEY=change-me-local-dev-key

# --- Database ---
# Used by the app (async driver) and by Alembic (sync driver derived automatically)
DATABASE_URL=postgresql+psycopg://ragdocs:ragdocs@db:5432/ragdocs
POSTGRES_USER=ragdocs
POSTGRES_PASSWORD=ragdocs
POSTGRES_DB=ragdocs

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=4

# --- Generation (optional) ---
# If unset, the API falls back to a fully local, extractive answer built
# from the top retrieved chunks — no external API calls or cost required
# to run this project end to end.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Uploads ---
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=20
